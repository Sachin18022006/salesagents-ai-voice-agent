# Environment Variables for Home Credit LAP Voice Agent

# Retell AI Platform Credentials (Optional for automated deployment)
# Get your API key from: https://beta.retellai.com/dashboard/api-keys
RETELL_API_KEY=your_retell_api_key_here

# Bolna Platform Credentials (Optional alternative)
BOLNA_API_KEY=your_bolna_api_key_here

# OpenAI API Key (Optional for standalone LLM test harness)
OPENAI_API_KEY=your_openai_api_key_here

# Local Server Configuration
PORT=8000
HOST=0.0.0.0
